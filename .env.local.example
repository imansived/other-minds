# Copy this file to .env.local and fill in your key:
#   cp .env.local.example .env.local
#
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Where the frontend's route handlers reach the API. Unset means
# http://127.0.0.1:8000, which is what `npm run dev:all` starts, so local
# development needs nothing here.
#
# In production the deployed backend goes here instead. On Vercel this is set
# in vercel.json; set it locally only to point a local frontend at a remote
# backend:
#   OTHER_MINDS_API_URL=https://other-minds-production.up.railway.app
